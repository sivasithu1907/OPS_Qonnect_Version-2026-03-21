# ════════════════════════════════════════════════════════════════════════════════
# Staging environment — EXAMPLE. Copy to `.env.staging` (same folder as docker-compose.staging.yml), fill in, never commit it.
#   cp .env.staging.example .env.staging && chmod 600 .env.staging
# Every secret must be NEW and DIFFERENT from production. No real value belongs in this example file.
# Generate secrets with:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# ════════════════════════════════════════════════════════════════════════════════

# Password of the staging PostgreSQL user (staging_fieldops). Required.
STAGING_DB_PASSWORD=

# JWT signing secret for staging, at least 32 characters. Required. Must not be the production secret.
STAGING_JWT_SECRET=

# Where the staging front end is opened from (browser origin). Default is the loopback port / an SSH tunnel.
# STAGING_CORS_ORIGIN=http://127.0.0.1:3001

# First start only (database has no enabled ADMIN): staging-only administrator. Remove these three lines afterwards.
STAGING_INITIAL_ADMIN_EMAIL=
STAGING_INITIAL_ADMIN_PASSWORD=
STAGING_INITIAL_ADMIN_NAME=Staging Admin

# How the API treats an activity change with no version token (old cached app): reject (default) | allow-logged
# STAGING_ACTIVITY_UNVERSIONED_WRITES=reject

# ── NOT configurable here, on purpose ──────────────────────────────────────────
# ENABLE_WHATSAPP / ENABLE_TV / ENABLE_N8N / ENABLE_EXTERNAL_NOTIFICATIONS are fixed to "false" inside docker-compose.staging.yml,
# and WA_*, N8N_WEBHOOK_URL, TV_TOKEN, API_KEY are fixed to empty / "staging-…" placeholders. Putting them in this file has no effect,
# and the backend refuses to start in staging if any of them is changed to a real value.

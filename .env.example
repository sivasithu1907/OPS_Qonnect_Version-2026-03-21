# ============================================================
# Qonnect Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub
# ============================================================

# ── Google Gemini AI ──────────────────────────────────────
API_KEY=your_google_gemini_api_key_here

# ── Authentication ────────────────────────────────────────
# Generate a long random string — used to sign JWT login tokens
# Example: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_secret_string

# ── Database ──────────────────────────────────────────────
# Required. Must match the password the existing database volume was created with.
DB_PASSWORD=change_this_database_password

# ── First administrator (fresh install ONLY) ──────────────────
# Used only when the database contains no enabled ADMIN account. Remove both
# lines after the first start. Never reuse a shared/default password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── TV display ────────────────────────────────────────────
# Required for the wall-mounted TV page. At least 24 random characters, e.g.
#   openssl rand -hex 24
# If empty, /api/tv-data is switched OFF (it no longer falls back to "open").
TV_TOKEN=
# Temporary switch for TV screens still running the old page (token in the URL).
TV_ALLOW_QUERY_TOKEN=false

# ── Server ────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=https://ops.yourdomain.com

# ── Integration switches (ALL DEFAULT TO DISABLED when unset) ──────────
# Read at call time. Only true / 1 / yes / on enable a switch; anything else (unset, empty, typo) = OFF.
#   ENABLE_WHATSAPP                 WhatsApp webhook + bot replies + every WhatsApp send
#   ENABLE_EXTERNAL_NOTIFICATIONS   team-lead and customer notifications (also needs ENABLE_WHATSAPP)
#   ENABLE_N8N                      outgoing n8n webhook calls
#   ENABLE_TV                       /api/tv-data and the TV display page
# PRODUCTION MUST SET THESE EXPLICITLY TO true (the production docker-compose.yml does not pass
# them through) or WhatsApp, n8n and TV stop working. Staging fixes all four to false in
# docker-compose.staging.yml.
ENABLE_WHATSAPP=false
ENABLE_TV=false
ENABLE_N8N=false
ENABLE_EXTERNAL_NOTIFICATIONS=false

# ── WhatsApp (Meta Business API) ─────────────────────────
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_PHONE_NUMBER_ID=your_meta_phone_number_id
WA_ACCESS_TOKEN=your_meta_permanent_access_token

# ── n8n Automation (optional — leave blank to disable) ───
# Set this when you connect n8n for notifications and reports
N8N_WEBHOOK_URL=

# ── Frontend (handled by Nginx proxy in production) ───────
VITE_API_BASE_URL=/api

# F-1 (activity version check). reject = refuse an unversioned workflow-critical change (HTTP 428, default).
# allow-logged = accept and log it as UNVERIFIED during a short rollout window, then switch back to reject.
ACTIVITY_UNVERSIONED_WRITES=reject
